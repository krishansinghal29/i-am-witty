# Copy to .env and fill in real values. .env is gitignored.

# Backend API (FastAPI on Cloud Run; local default below)
VITE_API_BASE_URL=http://localhost:8000

# App environment / release channel
VITE_APP_ENV=development
VITE_APP_VERSION=0.0.1
VITE_RELEASE_CHANNEL=development

# Firebase Auth (web config from Firebase console > Project settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# PostHog (analytics + feature flags)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# RevenueCat public SDK keys (per platform; native only)
VITE_REVENUECAT_IOS_KEY=
VITE_REVENUECAT_ANDROID_KEY=
VITE_REVENUECAT_WEB_KEY=
