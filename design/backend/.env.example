# DATABASE_URL is the POOLED endpoint (Neon PgBouncer) used by the app at runtime.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# DATABASE_URL_DIRECT is the NON-POOLED (direct) endpoint used by Alembic migrations.
DATABASE_URL_DIRECT=postgresql+asyncpg://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

APP_ENV=development

# --- Neon dev database init helpers ---
# Copy this file to .env.development for scripts/init_dev_db.py. If
# NEON_PROJECT_ID is omitted, the Neon CLI's active project context is used.
NEON_PROJECT_ID=your-neon-project-id
NEON_DEV_BRANCH=development
NEON_PARENT_BRANCH=production
NEON_DATABASE_NAME=neondb
NEON_ROLE_NAME=your-neon-role

# --- Integrations ---

# Firebase: verifies client ID tokens via the Admin SDK.
# Path to the service-account JSON. If unset, Google Application Default
# Credentials are used. FIREBASE_PROJECT_ID is optional.
FIREBASE_CREDENTIALS_FILE=/absolute/path/to/firebase-service-account.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# Deepgram: speech-to-text. The key transcribes submitted audio and mints
# short-lived client tokens (POST /v1/auth/grant) for the live path.
DEEPGRAM_API_KEY=your-deepgram-api-key
DEEPGRAM_PROJECT_ID=your-deepgram-project-id

# RevenueCat: subscription source of truth. Use the SECRET v1 REST key (not the
# public SDK key). REVENUECAT_WEBHOOK_AUTH is the exact Authorization header
# value you configure under Integrations -> Webhooks, compared on inbound calls.
REVENUECAT_API_KEY=your-revenuecat-secret-key
REVENUECAT_WEBHOOK_AUTH=your-configured-webhook-authorization-value

# PostHog: product analytics + experimentation flags.
POSTHOG_API_KEY=your-posthog-project-api-key
POSTHOG_HOST=https://us.i.posthog.com

# Capgo OTA (self-hosted — no Capgo cloud, no fee). The app polls
# POST /v1/ota/check for new web-layer bundles. OTA_ENABLED=false is the instant
# kill switch for every installed device (no rebuild). OTA_POINTER_URL is the
# public URL of production.json written by frontend/deploy_ota.sh; leave blank to
# always report "no update". See backend/README.md ("Over-the-air updates").
OTA_ENABLED=true
OTA_POINTER_URL=https://storage.googleapis.com/riffy-ota/ota/production.json

# LLM (litellm): prompt generation + transcript evaluation. Set the key(s) for
# whichever provider your model strings target. Models may be any litellm id,
# e.g. "gpt-5.6-sol" (OpenAI) or "gemini/gemini-2.5-flash" (Gemini).
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
LLM_GENERATOR_MODEL=gpt-5.6-sol
LLM_EVALUATOR_MODEL=gpt-5.6-sol

# TTS (OpenAI): spoken prompts. Reuses OPENAI_API_KEY. If that key is unset,
# TTS is skipped and prompts render as text only.
TTS_VOICE=nova
